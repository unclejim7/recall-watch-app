# Server
PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string

# How often to poll recall sources (cron syntax). Default: every 6 hours.
CRON_SCHEDULE=0 */6 * * *

# SMTP settings for sending alert emails.
# Any SMTP provider works (SendGrid, Postmark, Mailgun, Gmail app password, etc).
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password-or-api-key
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Optional: openFDA API key (raises the free rate limit from 40/min to 240/min)
# Get one free at https://open.fda.gov/apis/authentication/
FDA_API_KEY=

# Optional: instant SMS alerts via Twilio. Leave all three blank to disable SMS —
# email keeps working either way. Get credentials at https://console.twilio.com.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: instant Web Push alerts (no app install required). Leave blank to disable.
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@yourdomain.com
